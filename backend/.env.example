# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ROOT_DOMAIN=wedflix.com

# ─── Database (any PostgreSQL — Supabase, Neon, Railway, RDS, local) ─────────
DATABASE_URL=postgresql://user:password@host:5432/wedflix

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret for signing session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Local media storage (used until Cloudflare is configured) ───────────────
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8787

# ─── Cloudflare R2 — video + photo storage ───────────────────────────────────
# Without these, uploads fall back to the local uploads/ folder (dev only).
# Uploads go to R2 and are streamed back through the /api/v1/media route.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wedflix-media
